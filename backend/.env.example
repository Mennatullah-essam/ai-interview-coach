# Backend configuration for AI Interview Coach.
#
#   1. Copy it:  Copy-Item .env.example .env      (PowerShell, in the backend folder)
#   2. Put real values in .env only. .env is git-ignored; this file is committed.
#   3. Never put real passwords or secrets in this file.
#
# Real environment variables override values in .env.

# --- Environment -------------------------------------------------------------
# development | test | production. In production the app refuses to start unless
# JWT_SECRET is strong, cookies are Secure and CORS has no wildcard.
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (required) ------------------------------------------------------
# URL-encode special characters in the password (@ -> %40, # -> %23, % -> %25).
DATABASE_URL=postgresql+psycopg://interview_coach_user:CHANGE_ME@localhost:5432/interview_coach

# Optional: separate database ONLY for the PostgreSQL migration tests.
# The name MUST end in _test; those tests empty and rebuild it.
# TEST_DATABASE_URL=postgresql+psycopg://interview_coach_user:CHANGE_ME@localhost:5432/interview_coach_test

# --- Authentication -----------------------------------------------------------
# Secret that signs access tokens. Required in production; strongly recommended
# locally (without it a temporary secret is generated at each start).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Leave unset: Secure cookies are used automatically when APP_ENV=production.
# COOKIE_SECURE=true
# Login / sign-up attempts allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- HTTP ---------------------------------------------------------------------
# Comma-separated. Only needed when the frontend calls the API from another
# origin (the Vite dev proxy makes this unnecessary in development).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Accepted Host header values.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CV uploads ----------------------------------------------------------------
# Private folder for uploaded CV files (never served over HTTP, git-ignored).
# Default: backend/storage/cvs. An absolute path outside the project is safer.
# CV_STORAGE_DIR=C:\aic-private\cvs
MAX_CV_BYTES=5242880
CV_MIN_TEXT_CHARS=50

# --- Answer evaluation -----------------------------------------------------------
# lexical: built-in term-overlap similarity (default, no extra install).
# sbert:   local Sentence-Transformers model; first run: pip install -r requirements-ml.txt
SIMILARITY_BACKEND=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: a local folder with the model files, for offline machines.
# EMBEDDING_MODEL_PATH=

# --- Optional LLM (Milestone 5) ------------------------------------------------
# OFF by default (API spec D4: no paid or external AI service in the MVP). The app
# works fully without it. Any OpenAI-compatible chat server can be used, e.g. a
# free local one: Ollama (http://localhost:11434/v1) or LM Studio.
# CV text is never sent; answers are sent with emails/phones/links removed.
LLM_PROVIDER=none
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=            # only for hosted providers; keep it here, never in the frontend
# A non-local LLM_BASE_URL is refused unless this is true (answers would leave the machine):
LLM_ALLOW_EXTERNAL=false
# LLM_FEATURES=agent,evaluation
# LLM_TIMEOUT_SECONDS=12
# LLM_MAX_RETRIES=1
