# Frontend settings (copy to .env in the project root; .env is git-ignored).
# Nothing here is secret: every VITE_ value ends up in the browser bundle.

# Leave empty for local development: the app calls /api/... on its own origin
# and the Vite dev server forwards it to the backend (see vite.config.js).
# Set it only when the API is served from a different origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# (that origin must then be listed in the backend's CORS_ORIGINS).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests. Default shown.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
